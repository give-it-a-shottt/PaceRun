# server/.env — API 서버가 읽는다. 이 파일을 .env로 복사하고 값을 채운다.
# 값은 레포 · 문서 · 커밋 메시지에 적지 않는다.

# postgresql+psycopg://<사용자>:<비밀번호>@127.0.0.1:<포트>/<DB 이름>
DATABASE_URL=
# 테스트가 쓰는 별도 DB. 테스트가 테이블을 지우고 다시 만들므로 개발 DB와 반드시 달라야 한다.
TEST_DATABASE_URL=

# 액세스 토큰 서명 키. 32바이트 이상 무작위 값: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 웹 대시보드 주소(쉼표로 여러 개). 여기 적힌 주소에서 온 요청만 브라우저가 허용한다.
CORS_ORIGINS=http://localhost:5173
# 운영(HTTPS)에서는 true. 리프레시 쿠키를 HTTPS에서만 보내게 한다.
COOKIE_SECURE=false
